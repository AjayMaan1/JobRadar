# /etc/systemd/system/jobradar-worker.service
[Unit]
Description=JobRadar worker (crawl, enrich, alerts, resume pipeline)
After=network-online.target postgresql.service redis-server.service jobradar-web.service
Wants=network-online.target

[Service]
Type=simple
User=jobradar
WorkingDirectory=/opt/jobradar
EnvironmentFile=/opt/jobradar/.env
Environment=NODE_ENV=production APP_NAME=worker LOG_FORMAT=json
ExecStart=/usr/bin/node node_modules/.bin/tsx apps/worker/src/index.ts
Restart=always
RestartSec=10
TimeoutStopSec=40
# systemd watchdog fed by the worker heartbeat? Not needed: /api/health + Telegram alert on stale heartbeat
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/jobradar/data
LimitNOFILE=65536
MemoryMax=4G

[Install]
WantedBy=multi-user.target
