{
  "manifest_version": 3,
  "name": "JobRadar Autofill",
  "description": "Fills employer application forms with your JobRadar profile, attaches the chosen resume version and pastes drafted answers. You review and click Submit.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/sw.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://*.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*", "https://apply.workable.com/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["src/fill-engine.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "JobRadar Autofill" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
