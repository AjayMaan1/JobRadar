# Database
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar

# Redis
REDIS_URL=redis://localhost:6379


# Telegram (instant alerts for score >= 80)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email digest (daily at 08:00 IST)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Notification config
NOTIFICATION_CHANNELS=telegram,email
HIGH_SCORE_THRESHOLD=80
DIGEST_SCORE_THRESHOLD=60

# ── v2: gateway / watchlist ───────────────────────────────────────────────────
# Identify yourself to the sites you poll (strongly recommended; UA falls back to a neutral string + WARN)
CONTACT_URL=
CONTACT_EMAIL=
GATEWAY_GLOBAL_MAX_RPS=8
GATEWAY_TIMEOUT_MS=20000

# Priority classes that trigger instant Telegram alerts (P3 goes to the digest)
INSTANT_ALERT_CLASSES=p1_global_remote,p2_india_remote
ALERT_CAP_PER_FEED_PER_HOUR=10
TELEGRAM_OPS_CHAT_ID=

# Pay floor (INR/yr). Companies with confident evidence below this are demoted to weekly polling.
PAY_FLOOR_INR=3000000
PAY_FLOOR_CONFIDENCE=0.6

# Delhi-NCR cities for P3 (hybrid only)
NCR_CITIES=gurugram,gurgaon,noida,delhi,new delhi,faridabad,ghaziabad,ncr,delhi ncr,greater noida

# Closure + retention
GONE_AFTER_MISSING_POLLS=2
SUSPECT_DROP_FRACTION=0.5
SIGHTING_RETENTION_DAYS=365
FETCH_RUN_RETENTION_DAYS=30
PRUNE_CLOSED_JOBS=false
LIVENESS_DAILY_BUDGET=300

# Queue mode: bullmq (worker + Redis, default) | inline (no Redis; background work runs inside the web process —
# fine for a single-user box and for verification runs)
QUEUE_MODE=bullmq

# Worker concurrency — defaults below are for a 2-core / 16 GB box; raise on bigger machines
CRAWL_CONCURRENCY=2
POLL_CONCURRENCY=4
ENRICH_CONCURRENCY=2
CRAWL_RATE_DELAY_MS=1500

# Optional: absolute path to the local ever-jobs checkout used by the Ever Jobs adapter
# If omitted, JobRadar looks for a sibling ../ever-jobs checkout.
EVER_JOBS_PATH=

# Optional: open exchange rates for live FX (static table used if absent)
OPENEXCHANGERATES_API_KEY=

# ── v3: resumes / match (see audit/HLD-apply-portal-v3.md) ──────────────────────
# Sign-in (C1). First run: the owner account is created from ADMIN_EMAIL + ADMIN_PASSWORD on first login
# (or: pnpm user:create <email> <password>). Sessions: httpOnly cookie, 30-day sliding expiry.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=
# Dev only: skip login entirely and act as ADMIN_EMAIL (never set in a deployment).
AUTH_DISABLED=0
# Multi-user: allow self sign-up at POST /api/auth/register
ALLOW_SIGNUP=false
# Optional: lets monitors GET /api/health with header x-health-token without a session
HEALTH_TOKEN=

# ── AI: hosted free tiers by default, local Ollama optional (decision: docs/AI-PROVIDERS.md §4) ─────────────
# LLM_PROVIDER: one provider or a comma-separated CHAIN tried in order per call; members without a key are skipped.
#   hosted:  cerebras · gemini · groq · mistral · openrouter · openai · anthropic  (key env below)
#   local:   ollama · cli · fake · none (= deterministic features only)
# Default "fast" profile (./jobradar up --ai fast): Cerebras (fastest, 60k tokens/min, json_schema) → Gemini 2.0 Flash
# (1,500 req/day fallback) → Groq if its key is present → deterministic floor. No Ollama needed.
# Other profiles:  "ollama"  → everything local (private; minutes per call on a 2-core CPU, seconds with a GPU)
#                  "gemini,ollama" → public inputs on Gemini, resume text local    "cerebras,groq,ollama" → no-training tiers + local
LLM_PROVIDER=cerebras,gemini,groq,none
# Data-use policy: resume-derived prompts (parse_resume, suggest, headline, answers) are only sent to providers
# listed here or classed no-training (local, groq, cerebras, openai, anthropic). Gemini/Mistral/OpenRouter free tiers
# MAY train on inputs; they are listed here because this deployment chose speed over privacy. Contact details are
# always masked before any call regardless of provider.
LLM_PII_PROVIDERS=cerebras,gemini,groq
LLM_ALLOW_TRAINING_PROVIDERS_FOR_PII=0
# Hosted keys (free: cloud.cerebras.ai · aistudio.google.com · console.groq.com). Per-provider overrides:
# LLM_<ID>_MODEL, LLM_<ID>_RPM, LLM_<ID>_RPD, LLM_<ID>_TPM, LLM_<ID>_BASE_URL, LLM_<ID>_PAID=1
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct       # ollama model (only when ollama is in the chain); pulled automatically by ./jobradar up
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_THREAD=2                 # physical cores
OLLAMA_KEEP_ALIVE=30m
LLM_MAX_PROMPT_CHARS=16000          # prompt processing is slow on CPU; longer inputs are trimmed in the middle
LLM_CONCURRENCY=1                   # one model request at a time (CPU-bound)
# Daily budgets (calls / USD). Free local models: USD cap is irrelevant; the call caps still protect the CPU.
LLM_DAILY_CALL_CAP=2000
LLM_USER_DAILY_CALL_CAP=300
LLM_DAILY_USD_CAP=20

# Embeddings (C13 semantic search + fit): gemini (default: text-embedding-004, 768 dims, free) | ollama | openai | mistral | fake | none
#   ollama needs `ollama pull nomic-embed-text` (≈270 MB, 768 dims). "none" = keyword-only matching/search.
#   Changing the model re-embeds the corpus in full (vectors are keyed by model).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
EMBED_BACKFILL_BATCH=100            # jobs embedded per 15-min backfill run
# fit-v1 calibration (cosine → 0..100) and the evidence threshold; tune after a few real applications
FIT_COS_MIN=0.40
FIT_COS_MAX=0.82
FIT_EVIDENCE_TAU=0.72
VECTOR_INDEX_REFRESH_MS=60000

# File storage for uploaded resumes and rendered versions: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/objects
# Required for the local driver: signs download links (any random string, ≥ 16 chars). Rotate to revoke all links.
STORAGE_SIGNING_SECRET=
# Optional at-rest encryption for the local driver (AES-256-GCM). Files written before it was set stay readable.
STORAGE_ENCRYPTION_KEY=
# S3 / MinIO (when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256

# Worker concurrency for resume-parse / jd-analyze / ats-score / suggest (LLM lane, see LLM_CONCURRENCY) and PDF renders
RESUME_CONCURRENCY=1
RENDER_CONCURRENCY=1
# PDF rendering needs Chromium once per machine:  npx playwright install chromium

# Retention of derived artifacts (days): match reports on non-tailored versions; tailored versions never used in an application
REPORT_RETENTION_DAYS=180
TAILORED_VERSION_RETENTION_DAYS=365
# Opt-in Prisma query logging (includes bound parameters = PII for resume tables; keep off)
PRISMA_LOG_QUERIES=0

# ── v4 hardening (audit v4) ────────────────────────────────────────────────────────────────────────
# Public URL used in e-mails (password reset / verification links)
APP_URL=http://localhost:3000
# Only honour X-Forwarded-For when a proxy you control sets it (nginx/Caddy/Cloudflare). Off = per-user limits only.
TRUSTED_PROXY=0
# Self sign-up hardening: require e-mail verification before first login (needs SMTP)
SIGNUP_REQUIRE_VERIFICATION=false
# Sessions: 30-day sliding expiry, hard cap in days
SESSION_MAX_DAYS=90
# Per-account login lockout: attempts / window seconds
LOGIN_LOCK_ATTEMPTS=8
LOGIN_LOCK_WINDOW_SEC=900
# Per-user rate limits for expensive actions, as "count/windowSeconds"
RATE_UPLOAD=20/3600
RATE_ANALYSIS=60/3600
RATE_SUGGEST=40/3600
RATE_RENDER=30/3600
RATE_JD=30/3600
# Request body caps enforced at the edge (bytes)
MAX_JSON_BODY_BYTES=262144
MAX_UPLOAD_BODY_BYTES=6291456
# Extra browser origins allowed to call mutating routes (comma-separated; the app's own origin is always allowed)
ALLOWED_ORIGINS=
# Content-Security-Policy: report-only by default; set 1 once the UI has been checked against it
CSP_ENFORCE=0

# Logging: json (production default) | pretty · level: debug | info | warn | error
LOG_FORMAT=pretty
LOG_LEVEL=info
# Prometheus: GET /api/metrics with "Authorization: Bearer $METRICS_TOKEN"; worker serves :9464/metrics and /healthz
METRICS_TOKEN=
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1
# Worker heartbeat (ms) and how stale it may be before /api/health alerts (ms)
WORKER_HEARTBEAT_MS=30000
WORKER_HEARTBEAT_STALE_MS=180000
# Ops Telegram alerts for the same key at most every N seconds
OPS_ALERT_EVERY_SEC=3600

# LLM response cache (identical prompt → cached JSON) in seconds; LLM_CACHE=off disables
LLM_CACHE_TTL_SEC=604800
LLM_CACHE=on
# Inline-mode queue cap (QUEUE_MODE=inline): reject new background work beyond this many pending tasks
INLINE_MAX_PENDING=50
# Vectors of closed jobs are dropped after this many days (rows are kept)
CLOSED_JOB_VECTOR_RETENTION_DAYS=30

# Backups (tools/backup/backup.sh): directory, retention, optional encryption passphrase and rclone remote
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_PASSPHRASE=
BACKUP_REMOTE=
# Dead-man's switch URL pinged after each successful backup (healthchecks.io / cronitor)
HEALTHCHECK_URL=

# ── v5: dynamic user preferences (docs/HLD-dynamic-preferences.md) ────────────────────────────────────────
# evals (default): every job is evaluated per user from their preference document (tiers, score, alerts, inbox).
# legacy: the pre-v5 owner-centric P1/P2/P3 classes (kept one release for A/B; compare counts on /health).
PREFS_ENGINE=evals
# Fan-out cap: evaluate new jobs for users who signed in within this many days (others re-evaluate on next login)
PREFS_ACTIVE_DAYS=90
# Optional: seed the owner's target skills (comma-separated) when the preference document is created the first time.
# PAY_FLOOR_INR, INSTANT_ALERT_CLASSES and NCR_CITIES above are read ONCE for the same seed; edit them on /preferences afterwards.
USER_TARGET_SKILLS=
