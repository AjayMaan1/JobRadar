#!/usr/bin/env bash
# JobRadar — one entry point. See docs/HLD-unified-launcher.md.  Usage: ./jobradar up | down | status | doctor | logs | ai | systemd
set -euo pipefail
cd "$(dirname "$0")"
if [ -d "$HOME/.nvm/versions/node/v22.23.4/bin" ]; then
  export PATH="$HOME/.nvm/versions/node/v22.23.4/bin:$HOME/.local/bin:$PATH"
fi
if ! command -v node >/dev/null 2>&1; then echo "Node.js >= 22 is required (https://nodejs.org)"; exit 1; fi
major=$(node -p 'process.versions.node.split(".")[0]')
if [ "$major" -lt 22 ]; then echo "Node.js >= 22 is required (found $(node -v))"; exit 1; fi
exec node tools/launcher/cli.mjs "$@"
